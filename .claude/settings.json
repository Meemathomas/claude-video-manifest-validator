{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/venv-manifest-validator/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_py.py\"",
            "timeout": 30,
            "statusMessage": "Formatting with autopep8..."
          }
        ]
      }
    ]
  }
}
